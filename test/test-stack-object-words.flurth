local firth = require 'proto.bootstrap'


-- Automated tests for Firth stack object words ([]@, []>, >[], []swap, []clear, etc.)
return firth.dictionary.rethrow(firth[[
	// Create stack and push values
	:( [] type type.table " [] should create a stack object" test.assert_eq );
	:( [] []# 0 " [] should create an empty stack object" test.assert_eq );

	// Test []@ (top element)
	:( [] char a swap >[] char b swap >[] char c swap >[] dup []@ 
		char c " []@ should return top element" test.assert_eq 
		[]# 3 " Stack object should have 3 elements" test.assert_eq );

	// Test []> (pop)
	:( [] 1 swap >[] 2 swap >[] 3 swap >[] dup []>
		3 " []> should pop top element" test.assert_eq
		[]# 2 " Stack object should have 2 elements left" test.assert_eq );

	// Test >[] (push)
	:( 42 [] >[]
		dup []@ 42 " >[] should push element" test.assert_eq
		[]# 1 " Stack object should have 2 elements left" test.assert_eq );

	// Test []swap
	:( [] 1 swap >[] 2 swap >[] dup []swap []@
		1 " []swap should swap top two elements" test.assert_eq );

	// Test []clear
	:( [] 1 swap >[] 2 swap >[] dup []clear dup []#
		0 " []clear should empty the stack" test.assert_eq );

	// Edge case: Pop from empty stack
	// :( [] []>
	//	test.assert_eq(err:find(".+: UNDERFLOW$"), 1, " []> on empty stack should error" );

	// Edge case: Swap with one element
	// :( 1 [] >[] []swap
	//	test.assert_eq(err:find(".+: INSUFFICIENT HEIGHT$"), 1, " []swap with one element should error" );

	// Edge case: Clear already empty stack
	// :( [] dup []clear #
	//  test.assert_eq(height, 0, " []clear on empty stack should still be empty" );


	freeze // ⚠️ ALWAYS execute LAST
]])
