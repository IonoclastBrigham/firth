local firth = require 'proto.bootstrap'


-- covers: >, <, =, <=, >=, ~=, and, or, nand, nor, xor
return firth[[
	// comparisons //

	// test_greater
	:( 5 3 > " Larger should be greater than smaller." test.assert_true );

	// test_greater_false
	:( 3 5 > not " Smaller should not be greater than larger." test.assert_true );

	// test_less
	:( 3 5 < " Smaller should be less than larger." test.assert_true );

	// test_less_false
	:( 5 3 < not " Larger should not be less than smaller." test.assert_true );

	// test_equal
	:( 7 7 == " Equal values should compare as equal." test.assert_true );

	// test_equal_false
	:( 7 8 == not " Unequal values should not compare as equal." test.assert_true );

	// test_lesseq
	:( 5 5 <= " Equal values should compare as less or equal." test.assert_true );

	// test_lesseq_true
	:( 4 5 <= " Smaller should be less or equal to larger." test.assert_true );

	// test_lesseq_false
	:( 6 5 <= not " Larger should not be less or equal to smaller." test.assert_true );

	// test_greatereq_eq
	:( 5 5 >=  " Equal values should compare as greater or equal." test.assert_true );

	// test_greatereq_greater
	:( 6 5 >= " Larger should be greater or equal to smaller." test.assert_true );

	// test_greatereq_less
	:( 5 6 >= not " Smaller should not be greater or equal to larger." test.assert_true );

	// test_noteq_true
	:( 5 -5 ~= " Unequal values should compare as not equal." test.assert_true );

	// test_noteq_false
	:( 42 42 ~= not " Equal values should not compare as not equal." test.assert_true );

	// boolean logic //

	// test_and_TT
	:( true true and " TRUE AND TRUE should result in true." test.assert_true );

	// test_and_TF
	:( true false and not " TRUE AND FALSE should result in false." test.assert_true );

	// test_and_FT
	:( false true and not " FALSE AND TRUE should result in false." test.assert_true );

	// test_and_FF
	:( false false and not " FALSE AND FALSE should result in false." test.assert_true );

	// test_or_TT
	:( true true or " TRUE OR TRUE should result in true." test.assert_true );

	// test_or_TF
	:( true false or " TRUE OR FALSE should result in true." test.assert_true );

	// test_or_FT
	:( false true or " FALSE OR TRUE should result in true." test.assert_true );

	// test_or_false
	:( false false or not " FALSE OR FALSE should result in false." test.assert_true );

	// test_nand_FF
	:( false false nand " FALSE NAND FALSE should result in true." test.assert_true );

	// test_nand_TF
	:( true false nand " TRUE NAND FALSE should result in true." test.assert_true );

	// test_nand_FT
	:( false true nand " FALSE NAND TRUE should result in true." test.assert_true );

	// test_nand_TT
	:( true true nand not " TRUE NAND TRUE should result in false." test.assert_true );

	// test_nor_FF
	:( false false nor " FALSE NOR FALSE should result in true." test.assert_true );

	// test_nor_TF
	:( true false nor not " TRUE NOR FALSE should result in false." test.assert_true );

	// test_nor_FT
	:( false true nor not " FALSE NOR TRUE should result in false." test.assert_true );

	// test_nor_TT
	:( true true nor not " TRUE NOR TRUE should result in false." test.assert_true );

	// test_xor_TF
	:( true false xor " TRUE XOR FALSE should result in true." test.assert_true );

	// test_xor_FT
	:( false true xor " FALSE XOR TRUE should result in true." test.assert_true );

	// test_xor_TT
	:( true true xor not " TRUE XOR TRUE should result in false" test.assert_true );

	// test_xor_FF
	:( false false xor not " FALSE XOR FALSE should result in false." test.assert_true );

	// truthiness conversions //

	// test_nil_is_falsey
	:( nil >bool not " Nil as bool should be false." test.assert_true );

	//  test_strings_are_truthy
	:( " a string" >bool " Non-empty string as bool should be true."  test.assert_true );

	//  test_empty_string_is_truthy
	:( " " >bool " Empty string as bool should be true." test.assert_true );

	//  test_numbers_are_truthy
	:( 42 >bool " Non-zero number as bool should be true." test.assert_true );

	//  test_zero_is_truthy
	:( 0 >bool " Zero as bool should be true." test.assert_true );

	// test_tables_are_truthy
	:( {} >bool " Empty table as bool should be true." test.assert_true );

	// test_functions_are_truthy
	:( :( ); >bool " Function as bool should be true." test.assert_true );

	// edge cases //

	" a value" =: aValue
	" a second value" =: aSecond

	// test_and_TX_fallthrough_second
	:( aValue aSecond and aSecond " TRUTHY AND ANYTHING should be second value." test.assert_eq );
	:( true aSecond and aSecond " TRUTHY AND TRUTHY should be second value." test.assert_eq );
	:( aValue nil and nil " TRUTHY AND FALSEY should be second value." test.assert_eq );

	//  test_and_FX_short_circuit_first
	:( nil aValue and nil " FALSEY AND ANYTHING should be first value." test.assert_eq );
	:( false aValue and false " FALSEY AND ANYTHING should be first value." test.assert_eq );
	:( false nil and false " FALSEY AND ANYTHING should be first value." test.assert_eq );

	freeze // ⚠️ ALWAYS execute LAST
]]
