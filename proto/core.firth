char //see:comment_block_below_for_copyright_notice drop

char : create compile
	char %s parse create compile
	interpret buildfunc dup bindfunc
	compile_target.XT @@ immediates true pivot !! drop
: immediate
	compile_target.XT @@ immediates true pivot !! drop
	interpret buildfunc bindfunc
: %s
	char %s cpush
	interpret buildfunc dup bindfunc immediate
: \n
	char \n cpush
	interpret buildfunc dup bindfunc immediate
: \t
	char \t cpush
	interpret buildfunc dup bindfunc immediate
: word
	%s parse compiling if dup srcappend end
	interpret buildfunc bindfunc
: `
	word cpush
	interpret buildfunc dup bindfunc immediate
: ' word find cpush
	interpret buildfunc dup bindfunc immediate
: postpone
	word find ccall
	interpret buildfunc dup bindfunc immediate
: ;
	buildfunc bindfunc
	interpret buildfunc dup bindfunc immediate
: ;immed
	buildfunc dup bindfunc immediate
	interpret buildfunc dup bindfunc immediate

: skipch  -1 backtrack ;
: 2skipch -2 backtrack ;
: " skipch ` [^"]* parsematch cpush skipch ;immed
: parseline " ^[^\n]*" fmt parsematch compiling if dup srcappend end ;
: parsematch parsematch compiling if dup srcappend end ;
: // parseline drop ;immed // There, now we can comment our code!

// /////////////////////////////////////////////////////////////////////////////
// core.firth
// Core vocabulary for :Firth environments.
