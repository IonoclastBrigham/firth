//
// Formatting:
//	utf-8 ; unix ; 80 cols ; tabwidth 4
// /////////////////////////////////////////////////////////////////////////////

// text and parsing words
: ( 1 backtrack " %b()" parsematch
	dup countlines
	compiling if 3 -1 Lua.string.sub srcappend else drop end
	;immed ( ( nestable) parentheses)
: (NOTHING) ;immed
: (--) ;immed // shortcut, no stack effects
: (C:  2 backtrack postpone ( ;immed // cstack effects
: (--)(C: postpone (C: ;immed
: (R:  2 backtrack postpone ( ;immed // rstack effects
: (--)(R: postpone (R: ;immed
: (IO: 3 backtrack postpone ( ;immed // iostack effects
: (--)(IO: postpone (IO: ;immed
: (TS: 3 backtrack postpone ( ;immed // token stream effects
: (--)(TS: postpone (TS: ;immed
: (CB: 3 backtrack postpone ( ;immed // compile buf effects
: (--)(CB: postpone (CB: ;immed
: (EX: 3 backtrack postpone ( ;immed // execution effects for compiling words
: (--)(EX: postpone (EX: ;immed
: (OUT: 4 backtrack postpone ( ;immed // output stream effects
: (--)(OUT: postpone (OUT: ;immed
: TODO: (TS: .*\n) postpone // ;immed
: FIXME: (TS: .*\n) postpone // ;immed
: >string ( x -- s ) Lua.tostring ;
: .CR (--) \n .raw ;
: .2CR (--) \n \n .raw .raw ;
: .line ( x -- ) >string .raw .CR ;
: .TAB (--) \t .raw ;
: "" ( -- s ) ` (.-)"" parsematch trim cpush ;immed
: clips ( s -- s' ) 2 -2 Lua.string.sub ; // NOT the same as strip!
: eachword ( * s xt -- *) ; TODO: parse words from string and hand to xt
: .. (EX: s1 s2 -- s1..s2) " .." cbinop ;immed // string concat
: .." ( s1 -- s1..s2)(TS: s2)(EX: s1 -- s1..s2) postpone " postpone .. ;immed
: peekch input_buffer parse_pos dup Lua.string.sub ;
: str>word ( s istart -- s iend word ) over %s rot strparse ;
: strip ( s -- s' ) 0 str>word 2 shove 2 chop ;

// some basic arithmetic operators
: + (EX: a b -- a+b ) char + cbinop ;immed
: - (EX: a b -- a-b ) char - cbinop ;immed
: * (EX: a b -- a*b ) char * cbinop ;immed
: / (EX: a b -- a/b ) char / cbinop ;immed
: % (EX: a b -- a%b ) char % cbinop ;immed
: ** (EX: a b -- a^b ) char ^ cbinop ;immed // use ** because ^ is bit-wise xor

: 1+ ( n -- n' ) 1 + ;
: 1- ( n -- n' ) 1 - ;

: cpushvar ( name -- )(CB: push(dict[name])) cpush ' find ccall ;
: cstorevar ( name -- )(CB: dict[name]=x)
	dictionary cpush cpush (EX: x -- x dict name)
	' !! ccall ' drop ccall ;
: ++ (EX: -- n+1 )(TS: nvar )
	word dup
	compiling if
		cpushvar ' 1+ ccall ' dup ccall cstorevar
	else
		find 1+ dup dictionary 3 roll !! drop
	end
	;immed
: -- (EX: -- n-1 )(TS: nvar )
	word dup
	compiling if
		cpushvar ' 1- ccall ' dup ccall cstorevar
	else
		find 1- dup dictionary 3 roll !! drop
	end
	;immed
: -= ( n -- )(TS: ivar)
	word dup
	compiling if
		cpushvar ' swap ccall postpone - dictionary cpush cpush ' !! ccall ' drop ccall
	else
		find rot swap - dictionary rot !! drop
	end
	;immed

// some basic boolean operators
: > ( a b -- a>b ) char > cbinop ;immed
: < ( a b -- a<b ) char < cbinop ;immed
: == ( a b -- a==b ) " ==" cbinop ;immed
: >= ( a b -- a>=b ) " >=" cbinop ;immed
: <= ( a b -- a<=b ) " <=" cbinop ;immed
: ~= ( a b -- a!=b ) " ~=" cbinop ;immed
: 2not ( a b -- ~a ~b) swap not swap not ;
: && ( a b -- a&&b ) " and" cbinop ;immed
: || ( a b -- a||b ) " or" cbinop ;immed
: ^^ ( a b -- aXORb ) ' 2not ccall postpone ~= ;immed
: ~&& ( a b -- !a&&b ) postpone && ' not ccall ;immed
: ~|| ( a b -- !a||b ) postpone || ' not ccall ;immed

// Lambdas, functions, etc.
0 dictionary ` __firth_lambdaID !! drop
` __λ_0x%08X__ dictionary ` __firth_lambdaID_fmt !! drop
: nextλID ( -- s ) ++ __firth_lambdaID __firth_lambdaID_fmt fmt ;
: :( (--) nextλID create compile ;immed
: ); ( -- xt ) buildfunc ` xt @@ cpush ;immed
: lua{ ( * -- * )
	dictionary cpush
	" local dictionary = (...)\n"
	" local function lua(...)\n" ..
	1 backtrack " %b{}" parsematch clips ..
	" \nend\n" ..
	" setfenv(lua, dictionary.Lua)\n" .. FIXME: link both ways? make Lua weak?
	" return lua(select(2, ...))" .. fmt
	Lua.loadstring ccall
	;immed
: lua:( ( -- xt )
	dictionary
	" local dictionary = (...)\n"
	" local function lua(...)\n" ..
	1 backtrack " %b();" parsematch clips ..
	" \nend\n" ..
	" return lua, ..." .. fmt
	Lua.loadstring execute cpush
	;immed

// Minimal stack operations
: []@     ( stk -- stk x )	lua{ local stk = (...); return stk:top(), ... } ;
: []>     ( stk -- x )		lua{ local stk = (...); return stk:pop(), select(2, ...) } ;
: >[]     ( x stk -- stk )	lua{ local stk, x = ...; stk:push(x); return stk, select(3, ...) } ;
: []swap  ( stk -- )		lua{ local stk = (...); stk:swap(); return select(2, ...) } ;
: []dup   ( stk -- )        lua{ local stk = (...); stk:dup(); return select(2, ...) } ;
: []clear ( stk -- )		lua{ local stk = (...); stk:clear(); return select(2, ...) } ;
: []drop  ( stk -- )		lua{ local stk = (...); stk:drop(); return select(2, ...) } ;
: []#     ( stk -- n )		lua{ local stk = (...); return  stk.height, select(2, ...) } ;

// auxiliary stacks
: C@ ( -- x )(C: x -- x ) cstack []@ 1 yank ;
: C> ( -- x )(C: x -- ) cstack []> ;
: >C ( x -- )(C: -- x ) cstack >[] drop ;
: Cswap (--)(C: x y - y x ) cstack []swap ;
: Cclear (--)(C: * -- ) cstack []clear ;

: R@ ( -- x )(C: x -- x ) rstack []@ 1 yank ;
// ⚠️ >R is a compiler prim; do not implement in :Firth (see bootstrap)
// ⚠️ R> is a compiler prim; do not implement in :Firth (see bootstrap)
: R?> rstack []# 0 > if R> else nil end ;
: Rswap rstack []swap ;
: Rdup rstack []dup ;
: Rdrop rstack []drop ;
: Rclear (--)(C: * -- ) rstack []clear ;
: R# rstack []# ;
: R#? R# 0 > ;
: R++ ( -- n )(R: n -- n+1) R> dup 1+ >R ;

// tables, arrays
: {} ( -- {} ) lua{ return {}, ... } ;
: # ( s|t -- n ) lua{ return #(...), select(2, ...) } ;
: freeze ( n*x -- [ ...n*x ] ) stack.new ;
: insert ( x t -- t ) dup rot Lua.table.insert ; // Lua.table.insert "feels" backward, table first
: { (--)(TS: * '}' )(EX: * -- t )
	TODO: distinguish between a variable and a literal?
	{} while word dup ` } ~= do
		resolve dup Lua.type ` function == if execute end
		swap insert
	end drop
	compiling if cpush end
	;immed
: search ( x t -- n|nil ) nil >R eachi 2 pick ~= if drop else Rdrop >R end end drop R> ;

// error handling and debugging
: file.line line_num cpush ;immed
: file.name input_path cpush ;immed
: throw ( x -- )
	postpone file.line postpone file.name " %s:%d %s" cpush ' fmt ccall
	2 cpush ' Lua.error ccall
	;immed
: try ( compiles: * -- * )
	` [[TRY]] false :( ( xt -- xt )
		:( ( [xt] -- *) Lua.pcall )[1]; true
	); cbeginblock
	;immed
: catch ( compiles: * err? b -- * )
	cendblock ( -- xt )
	` [[CATCH]] false :( ( xt -- xt )
		:( ( * e? b [xt] -- * ) swap not if execute else drop end )[1];
		true
	); cbeginblock
	;immed
: assert" ( b -- )(TS: "msg")
	// grab the assert string and squirrel it away
	skipch ` [^"]* parsematch >C skipch // " compiles a push to the wrong stack
	// then start compiling the assert cleanup body
	` [[ASSERT]] false :( ( xt -- xt false)
		// pass compiled body thread along
		false
	); cbeginblock
	;immed
: ?throw
	cendblock ( -- cleanupthread)
	C>        ( -- cleanupthread msg)
	' not ccall postpone if ( b -- )
		swap ccall                      // compile call to cleanup thread
		cpush ' fmt ccall ' throw ccall // compile push message and call to throw
	postpone end
	;immed
: rethrow ( err? b -- * ) not if throw end ;

// some higher level stack manipulations
: nip ( a b -- b ) swap drop ;
: 2dup ( a b -- a b a b ) over over ;
: 3dup ( a b c -- a b c a b c ) 2 pick 2 pick 2 pick ;
: ndup ( n*x n -- 2n*x ) dup loops dup pick swap end drop ;
: 2drop ( a b -- ) drop drop ;
: 3drop ( a b c -- ) drop drop drop ;
// ndrop is spelled "n chop"
: ?drop ( x b -- x? ) if drop end ;
: reverse ( x(k)..x i -- x..x(k) )
	 // capture stack height; decrement because we don't want to count `i`
	height 1-
	// base cases and a few optimazations first, then more expensive SHOVE algo
	dup 2 <  >R 2dup == R> || if
		2drop
	else dup 2 == if
		2drop swap
	else dup 3 == if
		2drop pivot
	else
		TODO: local i instead of rstack
		swap dup >R - shove
		R> 1+ recurse
	end end end
	;
// immediately redefine; hide the index from interface
: reverse ( x(k)..x -- x..x(k) ) 1 reverse ;

// a few parser/interpreter/compiler control words
: xt ( {word} -- xt ) ` xt @@ ;
: xt? ( x -- b ) Lua.type ` function == ;
: xt?exec ( * x -- * ) dup xt? if execute end ;
: !exec: ( -- * )(TS: word) word resolve execute ;immed
: immediate ( xt|entry -- )
	// redefining to allow making raw XTs immediate i.e. lambdas
	dup xt? not if compile_target.XT @@ end
	immediates true pivot !! drop
	;
: 2word ( -- s1 s2 )(TS: word word ) word word ;
: #! ( -- )(TS: line)
	line_num 1 > input STDIN ~= && assert" Shebang only valid on first line; found on: " output line_num STDERR useoutput Lua.tostring .raw useoutput ?throw
	postpone //
	;immed

// values and variables
: store ( x name -- ) dictionary swap !! drop ;
: =: ( x -- )(TS: name)
	word dup find nil == assert" Variable redefinition: %s" ?throw
	cpush ' store ccall
	;immed
: ! ( x name -- )
	dup find nil ~= assert" Attempting to modify undefined variable %s" ?throw
	store
	;
: @ dup find dup nil ~= assert" Attempting to load an undefined variable"
		drop quote >string .raw " : " .raw
	?throw nip ;
: = ( x -- )(TS: name ) word cpush ' ! ccall ;immed
: delete (--)(TS: name) nil cpush word cpush ' ! ccall ;immed
: const ( x name -- )
	swap :( cpush )[1]; dup immediate swap store
	TODO: guard against re-binding `name`?
	;
: const: (--)(TS: word x ) 2word resolve xt?exec swap cpush const ;immed
: alias: (--)(TS: new old ) 2word find swap store ;immed

: ?. dup nil ~= if word resolve xt?exec else word drop end ;immed
: ?? dup nil == if drop word resolve xt?exec else word drop end ;immed

: type ( x -- s )
	dup Lua.getmetatable dup if
		` __type @@ dup if nip else drop Lua.type end
	else
		drop Lua.type
	end ;
const: type.xt ` function
const: type.number ` number
const: type.string ` string
const: type.table ` table
const: type.boolean ` boolean
const: type.nil ` nil
const: type.stack ` stack

: >bool ( x -- b ) not not ;
: >number ( x -- n )
	dup type type.boolean == if
		1 && 0 ||
	else
		dup nil == if drop 0 else string>number end
	end
	;
: __call@@ ( mt -- xt ) ` __call @@ ;
: executable? ( x -- b )
	dup xt? if
		drop true
	else
		Lua.getmetatable ?. __call@@ >bool
	end
	;
: immediate? ( word -- b )
	dup executable? not if find end
	immediates swap @@ >bool // will be nil if not immediate, so cast to bool
	;

// : variable ( name -- entry ) create dup does> NOP ;
// : var: ( x -- ) word variable ! ;immed
// : val: ( x -- ) word variable ! last does> @ ;immed

// randomness
0 =: RANDOM_SEED
: srand     ( n -- )                     dup = RANDOM_SEED Lua.math.randomseed ;
: rand      ( -- 0.0≤n≤1.0 )             Lua.math.random0 ;
: rand..max ( maxn -- 0≤n≤maxn )         1+ Lua.math.random1 1- ; // adjust Lua's 1..maxn to 0..maxn
: rand..in  ( minn maxn -- minn≤n≤maxn ) Lua.math.random2 ;
: rand-element ( t -- x ) 1 over # rand..in @@ ;
: rand-select{ ( -- x)(TS: *) postpone { ' rand-element ccall ;immed
Lua.os.time srand

// strings and i/o
const: \r char \r
const: \n char \n
const: \t char \t
const: \v char \v
const: SPACE "  "
const: EMPTY " "

: pushinput  ( fd -- )(IO: fd ) input iostack >[] drop useinput ;
: pushoutput ( fd -- )(IO: fd ) output iostack >[] drop useoutput ;
: popinput  (--)(IO: fd -- ) iostack []> useinput ;
: popoutput (--)(IO: fd -- ) iostack []> useoutput ;

: . ( x -- ) >string .raw SPACE .raw ;
: .char (--)(TS: ch) postpone char ' . ccall ;immed
: ." ( -- )(TS: "s") postpone " ' . ccall ;immed
: .fmt ( * s -- s' ) fmt .raw ;
: .fmt" ( * -- )(TS: "s") postpone " ' .fmt ccall ;immed
: fmt" ( * -- )(TS: "s") postpone " ' fmt ccall ;immed
: .x ( n -- ) " 0x%x " .fmt ;
: .X ( n -- ) " 0X%X " .fmt ;
: .err ( s -- ) STDERR pushoutput . popoutput ;
: .err" (--)(TS: "s") postpone " ' .err ccall ;immed
: .dup ( x - x )(OUT: "x") dup . ;
: .pick ( x(i) ... x(1) x i -- x(i) ... x(1) x )(OUT: "x(-i)") pick . ;
: .C (C: * -- * ) cstack . ;
: .c (C: * -- ) .C Cclear ;
: .R (R: * -- * ) rstack . ;
: .r (R: * -- ) .R Rclear ;
: .s ( * -- ) .S clear ;
: printstack ( * -- ) .fmt" \n<==[ " .S .char ] .CR ;
: joinstack ( * s -- s' )
	>R EMPTY
	while height 1 > do swap >string R@ rot .. .. end
	Rdrop 1 -2 Lua.string.sub ;

: see ( word -- )
	// find meta-entry by name..?
	meta over @@ ( -- word entry? )
	// find meta-entry by value..?
	dup if nip else drop meta over find @@ end ( -- entry|(word nil) )
	dup not if
		PRINT_ERRS >R
		true = PRINT_ERRS
		drop false lookup_err
		R> = PRINT_ERRS
	else
		.char : dup ` name @@ .
		` srcbuf @@ each nip . end
		drop
	end
	;
: see: (--)(TS: word ) word cpush ' see ccall ;immed

// miscellaneous util words and stuff
: NOP ;
alias: NOOP NOP
// : calls: (--) postpone ` " calledby" @@ nip foreach drop " \tcalledby". . .CR end ;
// : calledby: (--) postpone ` " calls" @@ nip foreach drop " \tcalls"   . . .CR end ;

// math
alias: abs Lua.math.abs
alias: ceil Lua.math.ceil
alias: floor Lua.math.floor
alias: remainder Lua.math.modf
const: inf Lua.math.huge
-1 inf * ` -inf const
0 0 / ` nan const
alias: add +
alias: sub -
alias: mul *
alias: div /
alias: mod %
alias: pow **
: /% ( n1 n2 -- floor(n1/n2) n1%n2) 2dup / floor -rot % ;
: percent ( n p -- n*(p/100) ) 100 / * ; // e.g. `200 25 percent` => 50
: isnan? ( n -- b ) dup == not ; // nan ≠ nan
: sign ( n -- -1|0|1|nan )
	dup 0 > 1   ( -- n b 1 )       && // collapse
	over 0 < -1 ( -- n 1|#f b -1 ) && // collapse
	||          ( -- n -1|1|#f )
	swap || ;

alias: greater? >
alias: less? <
alias: eq? ==
alias: greatereq? >=
alias: lesseq? <=
alias: noteq? ~=

alias: and &&
alias: or ||
alias: xor ^^
alias: nand ~&&
alias: nor ~||

alias: & Lua.bit.band
alias: | Lua.bit.bor
alias: ^ Lua.bit.bxor
alias: ~ Lua.bit.bnot
alias: << Lua.bit.lshift
alias: >> Lua.bit.rshift

: round>0 ( f -- i ) dup 0 < if ceil else floor end ;
: round ( f -- i ) dup remainder drop abs 0.5 >= if ceil else floor end ;
: even? ( n -- b ) remainder nip 1 & 0 == ; // ignores fractional part
: odd? ( n -- b ) remainder nip 1 & 1 == ;  // ignores fractional part

// control and os words
alias: exit Lua.os.exit
: bye ( * -- )
	printstack
	.fmt" Goodbye 🖤\n"
	0 exit
	;

// metatables
: getmeta ( x -- mt? ) Lua.getmetatable ;
: )meta.tostring; ( mt -- mt)(EX: mt.__tostring = thr)
	postpone ); ' swap ccall ` __tostring cpush ' !! ccall
	;immed
: meta.tostring[1] ( s mt -- mt ) " enum " rot .. :( )[1]; swap ` __tostring !! ;
: entry? ( x -- b ) getmeta entrymt  == ;

// symbols and enums
: symbol.create ( s -- )
	dup {} ` value !!
	{} :( ` value @@  )meta.tostring; Lua.setmetatable swap store ;
: symbol: (--)(TS: word) char : word .. dup defined not if symbol.create else drop end ;immed

: counter: ( n -- ) Rdrop word >number >R ;immed
{} ( register of enumerant modifiers )
	true swap ` counter: !!
	true swap ` // !!
	true swap ` ( !!
	=: enum.MODIFIERS
: enum.mod? ( word -- b ) enum.MODIFIERS swap @@ >bool ;
: enum.parsebody (--)(TS: "{...enumerations}")
	" %b{}" parsematch clips pushparsestate = input_buffer 1 = parse_pos 1 = line_num ;
: enum.execmod ( word -- b )
	dup enum.mod? if
		find execute
		word dup >bool dup FIXME: ?continue skips setting loop values
	else
		false
	end ;
: enum.populate ( enum enumerant -- enum enumerant) over @ over R@ -rot !! drop ;
: enum.inject ( enum enumerant --)
	over fmt" %s.%s" R++ swap const ;
: enum.create ( name -- )
	{} over store 0 >R
	enum.parsebody
	while word dup >bool do
		enum.execmod ?continue // exec immeds, otherwise it's an enumeration
		enum.populate // grab the enum table and insert the counter with name
		enum.inject // add to dictionary as pre-dotted name
	end drop
	popparsestate
	Rdrop dup dup find
	Lua.table.frozen swap over getmeta meta.tostring[1] drop swap ! ;
: enum: word enum.create ;immed

// optional testing module
` Lua.test defined if
	' Lua.test =: test
	0 3 ' Lua.test.assert_eq wrapfunc =: test.assert_eq
	0 2 ' Lua.test.assert_true wrapfunc =: test.assert_true
end

// copyright, version, banner
: Copyright (--)
	` Copyright create compile
		` Copyright cpush ' . ccall parseline trim cpush ' . ccall ' .2CR ccall
		buildfunc dup bindfunc
	xt ccall
	;immed
" LICENSE.firth" runfile
alias: © Copyright
const: VERSION " pre-alpha3"
: banner (--) ." :Firth ver." VERSION . .char | © ;
