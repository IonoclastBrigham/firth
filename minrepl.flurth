#!/usr/bin/env rlwrap --always-readline luajit
--------------------------------------------------------------------------------
--! @file
--! @brief Tiny minimal REPL for :Firth language.
--! @author btoskin - <brigham@ionoclast.com>
--! @copyright © 2021-2025 Brigham Toskin
--
-- <p>This file is part of the :Firth language reference implementation. Usage
-- and redistribution of this software is governed by the terms of a modified
-- MIT-style license. You should have received a copy of the license with the
-- source distribution; if not, you may find it online at:
-- <https://github.com/IonoclastBrigham/firth/blob/master/LICENSE.firth></p>
--
-- Formatting:
--  utf-8 ; unix ; 80 cols ; tabwidth 4
--------------------------------------------------------------------------------


local firth = require "proto.bootstrap"
local stringio = require "firth.stringio"


if not firth.loaded then
	error(":Firth bootstrap failed to load; cannot start REPL...\n" .. firth.load_err, 1)
end
firth.dictionary.PRINT_ERRS = true

local success, err = firth([[
	// true = DEBUG_LOGS
	true = PRINT_ERRS
	false =: _repl_showstack?
	: ?printstack _repl_showstack? if printstack end ;
	: _repl_status_prompt
		compiling if
			drop .fmt" \t" // if compiling is true we know there wasn't an error
		else
			if ." ok" else PRINT_ERRS if fmt" %s\n" .err else (NOTHING) end end
			` ➤ .
		end ;

	: REPL ( * b -- *' b' )
		?printstack _repl_status_prompt
		readline dup not if drop ." bye" bye end // nil => EOF => CTRL+D
		' runstring Lua.pcall recurse ;

	` firth/cli.firth runfile not if " Could not load cli extensions: " throw end
	height 0 > if
		reverse SPACE joinstack
		 ' runstring Lua.pcall
		 dup if DOREPL not if drop printstack 0 exit else banner end end
		 DOREPL and REPL // DOREPL and [runstring success]
	else
		banner true REPL
	end
]], ...)
if not success then
	stringio.printline(stringio.stderr(), err); os.exit(1)
end
