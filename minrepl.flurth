#!/usr/bin/env rlwrap --always-readline luajit
--------------------------------------------------------------------------------
--! @file
--! @brief Tiny minimal REPL for :Firth language.
--! @author btoskin - <brigham@ionoclast.com>
--! @copyright © 2021-2025 Brigham Toskin
--
-- <p>This file is part of the :Firth language reference implementation. Usage
-- and redistribution of this software is governed by the terms of a modified
-- MIT-style license. You should have received a copy of the license with the
-- source distribution; if not, you may find it online at:
-- <https://github.com/IonoclastBrigham/firth/blob/master/LICENSE.firth></p>
--
-- Formatting:
--  utf-8 ; unix ; 80 cols ; tabwidth 4
--------------------------------------------------------------------------------


local table = table

local stringio = require "firth.stringio"
local firth = require "proto.bootstrap"


if not firth.loaded then
    error(":Firth bootstrap failed to load; cannot start REPL", 2)
end

local dictionary = firth.dictionary
dictionary.PRINT_ERRS = true -- enable for REPL output

local function REPL(clean, ...)
    -- print stack from previous line
    dictionary['?printstack'](...)

    -- error output / prompt
    firth([[
        if ." ok" else PRINT_ERRS if fmt" %s\n" .err end end
        ` ➤ .
    ]], clean, ...)
    if dictionary.compiling then stringio.printstr('    ') end

    -- read input
    local line = stringio.readline()
    if line == nil then
        -- nil => EOF => CTRL+D
        stringio.printstr("bye")
        dictionary.bye(select(clean and 1 or 2, ...))
    end
    return REPL(firth(line, select(clean and 1 or 2, ...)))
end

-- dictionary.DEBUG_LOGS = true
firth[[
    false =: showstack
    : ?printstack showstack if printstack end ;
]]
if select("#", ...) > 0 then
    firth.runfile("firth/cli.firth")
    local src = table.concat({...}, " ")
    return REPL(firth(src.." DOREPL not if printstack 0 exit else banner end DOREPL"))
else
    dictionary.banner()
    return REPL(true, ...)
end
