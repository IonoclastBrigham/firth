#!/usr/bin/env rlwrap --always-readline luajit
--------------------------------------------------------------------------------
--! @file
--! @brief Tiny minimal REPL for :Firth language.
--! @author btoskin - <brigham@ionoclast.com>
--! @copyright © 2021-2025 Brigham Toskin
--
-- <p>This file is part of the :Firth language reference implementation. Usage
-- and redistribution of this software is governed by the terms of a modified
-- MIT-style license. You should have received a copy of the license with the
-- source distribution; if not, you may find it online at:
-- <https://github.com/IonoclastBrigham/firth/blob/master/LICENSE.firth></p>
--
-- Formatting:
--  utf-8 ; unix ; 80 cols ; tabwidth 4
--------------------------------------------------------------------------------


local firth = require "proto.bootstrap"
local loaded, dictionary = firth.loaded, firth.dictionary


if not loaded then
	-- TODO: handle this a little more elloquently.
	error(":Firth bootstrap failed to load; cannot start REPL - " .. firth.load_err, 1)
end
dictionary.PRINT_ERRS = true

-- just reverses its arguments; always call as _reverse_r(0, ...)
local function _reverse_r(i, ...)
	local height = select("#", ...)
	if height - i < 1 then
		return
	end
	return select(height - i, ...), _reverse_r(i+1, ...)
end

firth([[
	// true = DEBUG_LOGS
	true = PRINT_ERRS
	false =: _repl_showstack
	: ?printstack _repl_showstack if printstack end ;
	: _repl_do_prompt
		?printstack
		if ." ok" else PRINT_ERRS if fmt" %s\n" .err else end end
		` ➤ .
		compiling if .fmt" \t"  end ;

	: REPL ( * b -- *' b' )
		_repl_do_prompt

		// read input... nil => EOF => CTRL+D
		readline dup not if ." bye" bye end

		// evaluate input
		// try runstring catch " error..?" false end recurse ;
		' runstring Lua.pcall recurse ;

	height 0 > if
		` firth/cli.firth runfile not if " Could not load cli extensions." throw end
		SPACE joinstack " DOREPL not if printstack 0 exit else banner end DOREPL" ..
		// try runstring catch false end REPL
		// .dup .CR
		' runstring Lua.pcall  REPL
	else
		banner true REPL
	end
]], _reverse_r(0, ...))
