// Guess-the-Number! Based on Syn9's mini game example.
// <https://github.com/Syn-Nine/c3-mini-games>

// state
6 =: tries
20 rand..max =: secret
0 =: guess

// game loop
while tries 0 > do
	tries .fmt" Enter a number between 0 and 20, %d tries remaining: "

	STDIN .readline strip >number = guess
	guess nil ~= if
		guess secret < if .fmt" Too Small\n" end
		guess secret > if .fmt" Too Large\n" end
		guess secret == if .fmt" You Win!\n" 0 = tries end

		tries 1- = tries
	end
end

.fmt" Game Over\n"
